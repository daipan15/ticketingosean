# =============================================
# OSEAN Ticketing System — Environment Config
# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke Git!
# =============================================

# --- Database ---
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=osean_db

# --- CORS (pisahkan dengan koma jika lebih dari 1 origin) ---
# Contoh: https://tiket.osean.ac.id,https://osean.ac.id
APP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# --- SMTP Gmail ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_digit_app_password
SMTP_FROM_NAME=OSEAN Ticketing

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# --- Midtrans ---
MIDTRANS_SERVER_KEY=Mid-server-XXXXXXXXXXXXXXXXXXXXXXXX
MIDTRANS_CLIENT_KEY=Mid-client-XXXXXXXXXXXXXXXXXXXXXXXX
# true = production, false = sandbox
MIDTRANS_IS_PRODUCTION=true
