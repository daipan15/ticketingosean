# =============================================
# OSEAN Ticketing System — .gitignore
# =============================================

# --- Environment & Secrets ---
.env
*.env.local
*.env.production

# --- Debug & Log Files ---
*.txt
!.env.example

# --- Upload Files (user content) ---
osean-backend/uploads/*
!osean-backend/uploads/.gitkeep

# --- OS & IDE ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.suo
*.user

# --- PHP ---
vendor/
composer.lock

# --- Temporary ---
*.tmp
*.bak
*.swp
*~
